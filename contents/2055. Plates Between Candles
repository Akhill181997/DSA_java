class Solution {
    public int[] platesBetweenCandles(String s, int[][] queries) {
        int n = s.length();
        int[] prefixSum = new int[n];
        int[] leftCandle = new int[n];
        int[] rightCandle = new int[n];
        int[] result = new int[queries.length];
        
        int count = 0;
        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '*') {
                count++;
            }
            prefixSum[i] = count;
        }
        
        int left = -1;
        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '|') {
                left = i;
            }
            leftCandle[i] = left;
        }
        
        int right = -1;
        for (int i = n - 1; i >= 0; i--) {
            if (s.charAt(i) == '|') {
                right = i;
            }
            rightCandle[i] = right;
        }
        
        for (int i = 0; i < queries.length; i++) {
            int l = queries[i][0];
            int r = queries[i][1];
            int leftBound = rightCandle[l];
            int rightBound = leftCandle[r];
            
            if (leftBound != -1 && rightBound != -1 && leftBound < rightBound) {
                result[i] = prefixSum[rightBound] - prefixSum[leftBound];
            } else {
                result[i] = 0;
            }
        }
        
        return result;
    }
}
