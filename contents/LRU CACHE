class LRUCache {
    class Node{
        int key,value;
        Node prev,next;
        Node(int k,int v){
            this.key=k;
            this.value=v;
        }
        Node(){
            this(0,0);
        }
    }
    HashMap<Integer,Node> map;
    Node head,tail;
    int capacity, count;
    public LRUCache(int capacity) {
        this.capacity=capacity;
        this.count=0;
        head=new Node();
        tail=new Node();
        head.next=tail;
        tail.prev=head;
        map=new HashMap<>();
        
    }
    
    public int get(int key) {
       Node n=map.get(key);
       if(n==null){
        return -1;
       } 
       RemoveAndAdd(n);
       return n.value;
    }
    
    public void put(int key, int value) {
        Node n=map.get(key);
        if(n==null){
            n=new Node(key,value);
            map.put(key,n);
            addToHead(n);
            ++count;
        } else{
            n.value=value;
            RemoveAndAdd(n);
        }
        if(count>capacity){
            Node toDel=tail.prev;
            Remove(toDel);
            map.remove(toDel.key);
            count--;
        }
        
    }
    void RemoveAndAdd(Node n){
        Remove(n);
        addToHead(n);
    }
    void addToHead(Node n){
        Node after=head.next;
        head.next=n;
        n.prev=head;
        n.next=after;
        after.prev=n;

    }

    void Remove(Node node){
        Node before=node.prev, after=node.next;
        before.next=after;
        after.prev=before;
    }
}

