class Solution {
    public int partitionString(String s) {
        int partitions = 1; 
        Set<Character> currentSet = new HashSet<>();
        
        for (char c : s.toCharArray()) {
            if (currentSet.contains(c)) {
              
                partitions++;
                currentSet.clear(); 
            }
            currentSet.add(c); 
        }
        
        return partitions;
    }
}
